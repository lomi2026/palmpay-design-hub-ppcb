{
  "name": "@palmpay/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:deploy": "prisma migrate deploy && node dist/main.js",
    "start:deploy:bootstrap": "prisma migrate deploy && pnpm run prisma:seed && pnpm run prisma:bootstrap:test && pnpm run prisma:import:v9-1-projects && pnpm run prisma:import:v9-1-ai-catalog && pnpm run prisma:import:v9-1-design-assets && node dist/main.js",
    "start:dev": "node scripts/dev.mjs",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:bootstrap:test": "tsx prisma/bootstrap-test-environment.ts",
    "prisma:import:v9-1-projects": "tsx prisma/import-v9-1-ai-projects.ts",
    "prisma:import:v9-1-ai-catalog": "tsx prisma/import-v9-1-ai-catalog.ts",
    "prisma:import:v9-1-design-assets": "tsx prisma/import-v9-1-design-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/swagger": "latest",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "dotenv": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "eslint": "9.39.1",
    "eslint-config-prettier": "latest",
    "eslint-plugin-prettier": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "source-map-support": "latest",
    "ts-node": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest"
  }
}
